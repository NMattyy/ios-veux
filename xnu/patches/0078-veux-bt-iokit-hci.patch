+static void
+bt_hci_rx_frame(const uint8_t *data, uint32_t len)
+{
+	if (st.hci_rx_handler) {
+		st.hci_rx_handler(data, len, st.hci_rx_ctx);
+	}
+}
+
+static void
+bt_rx_dispatch(void)
+{
+	uint32_t status = bt_rd(st.se, SE_GENI_RX_FIFO_STATUS);
+	unsigned wc = (unsigned)(status & RX_FIFO_WC_MSK);
+	if (!wc) {
+		return;
+	}
+	if (wc > BT_RX_BUF_WORDS) {
+		wc = BT_RX_BUF_WORDS;
+	}
+	unsigned rbv = (status & RX_LAST_BYTE_VALID_MSK) >>
+	    RX_LAST_BYTE_VALID_SHFT;
+	bool last = (status & RX_LAST) != 0u;
+	unsigned bytes = (wc - 1u) * 4u;
+	bytes += (last && rbv) ? rbv : 4u;
+
+	uint32_t buf[BT_RX_BUF_WORDS];
+	for (unsigned i = 0; i < wc; ++i) {
+		buf[i] = bt_rd(st.se, SE_GENI_RX_FIFO);
+	}
+	st.rx_bytes += bytes;
+
+	/* H4 reassembly: accumulate bytes into st.h4_buf, dispatch complete frames. */
+	const uint8_t *p = (const uint8_t *)buf;
+	for (unsigned i = 0; i < bytes; ++i) {
+		uint8_t b = p[i];
+
+		switch (st.h4_expect) {
+		case 0: /* H4 type byte */
+			st.h4_len = 0;
+			st.h4_buf[st.h4_len++] = b;
+			if (b == H4_CMD || b == H4_EVENT || b == 0x02u || b == 0x03u) {
+				st.h4_expect = 1;
+			} else {
+				st.h4_expect = 0; /* unknown type, drop */
+			}
+			break;
+		case 1: /* event code / ACL handle */
+			st.h4_buf[st.h4_len++] = b;
+			if (b == HCI_EV_VENDOR) {
+				st.h4_have_event = true;
+			}
+			st.h4_expect = 2;
+			break;
+		case 2: /* length byte */
+			st.h4_buf[st.h4_len++] = b;
+			st.h4_expect = 3;
+			break;
+		case 3: /* payload */
+			st.h4_buf[st.h4_len++] = b;
+			if (st.h4_len >= 3u + st.h4_buf[2]) {
+				/* Complete H4 frame. */
+				bt_hci_rx_frame(st.h4_buf, st.h4_len);
+				st.h4_expect = 0;
+				st.h4_have_event = false;
+			} else if (st.h4_len >= sizeof(st.h4_buf)) {
+				st.h4_expect = 0;
+			}
+			break;
+		}
+	}
+}
+
+void
+veux_bt_hci_send(const uint8_t *data, uint32_t len)
+{
+	if (!st.se || !data || !len) {
+		return;
+	}
+	bt_tx(data, len);
+}
+
+void
+veux_bt_hci_set_rx_handler(void (*handler)(const uint8_t *, uint32_t, void *), void *context)
+{
+	st.hci_rx_handler = handler;
+	st.hci_rx_ctx = context;
+}
+
+unsigned
+veux_bt_hci_poll(void)
+{
+	if (!st.se) {
+		return 0;
+	}
+	bt_rx_dispatch();
+	return st.rx_bytes;
+}
+
+void
+veux_bt_hci_shutdown(void)
+{
+	st.dead = true;
+}
